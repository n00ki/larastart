{
  "type": "module",
  "private": true,
  "scripts": {
    "build": "vite build && vite build --ssr",
    "build:ssr": "pnpm run build",
    "dev": "vite",
    "format": "prettier --write resources/",
    "format:check": "prettier --check resources/",
    "check": "svelte-check resources/ --tsconfig ./tsconfig.json --config ./svelte.config.js",
    "check:watch": "svelte-check resources/ --tsconfig ./tsconfig.json --config ./svelte.config.js --watch",
    "lint": "eslint . && svelte-check resources/ --tsconfig ./tsconfig.json --config ./svelte.config.js",
    "fix": "prettier --write . && eslint . --fix",
    "postinstall": "npx simple-git-hooks"
  },
  "optionalDependencies": {
    "@laravel/multiplex": "^0.4.5",
    "@rollup/rollup-linux-x64-gnu": "4.68.6",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.5",
    "lightningcss-linux-x64-gnu": "^1.33.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@inertiajs/core": "^3.11.0",
    "@inertiajs/svelte": "^3.11.0",
    "@inertiajs/vite": "^3.11.0",
    "@laravel/passkeys": "^0.4.1",
    "@laravel/vite-plugin-wayfinder": "^0.1.11",
    "@lucide/svelte": "^1.75.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tsconfig/svelte": "^5.0.9",
    "@types/eslint": "^9.6.1",
    "@types/node": "^26.6.6",
    "bits-ui": "^2.21.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-svelte": "^3.24.1",
    "fontaine": "^1.0.3",
    "globals": "^17.14.0",
    "laravel-vite-plugin": "^3.2.1",
    "lint-staged": "^17.6.1",
    "maildev": "^3.0.0",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "simple-git-hooks": "^2.14.0",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "svelte-sonner": "^1.2.3",
    "svelte-transition": "^0.0.17",
    "tailwind-variants": "^4.0.2",
    "tailwindcss": "^4.3.5",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "**/*.php": [
      "./vendor/bin/pint"
    ],
    "{app,bootstrap,database,public}/**/*.php": [
      "./vendor/bin/rector"
    ],
    "{app,tests}/**/*.php": [
      "./vendor/bin/phpstan analyse -c ./phpstan.neon --error-format=table"
    ],
    "resources/**/*.{js,ts,svelte,css,json,md}": [
      "prettier --write",
      "eslint --cache --fix"
    ]
  }
}
