includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:

    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    # Native PHP cannot express iterable value types. PHPDoc remains optional,
    # while every other level 7 check stays enabled.
    ignoreErrors:
        -
            identifier: missingType.iterableValue
